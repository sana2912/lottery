{
  "name": "lottery-intelligence-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun --env-file=.env.development next dev",
    "build": "bun next build",
    "start": "bun --env-file=.env.development next start",
    "lint": "bun --bun biome check . && bun --bun eslint .",
    "format": "bun --bun biome format --write .",
    "check": "bun --bun biome check . && bun --bun eslint . --max-warnings=0 && bun run typecheck",
    "docker:local": "docker compose --env-file .env.development -f docker-compose.local.yml up --build",
    "docker:local:down": "docker compose --env-file .env.development -f docker-compose.local.yml down",
    "docker:local:logs": "docker compose --env-file .env.development -f docker-compose.local.yml logs -f web",
    "docker:local:up": "docker compose --env-file .env.development -f docker-compose.local.yml up --build -d",
    "test": "bun --bun test",
    "typecheck": "bun --bun tsc --noEmit",
    "prisma:generate": "bunx --bun prisma generate",
    "db:generate": "bun --env-file=.env.development x --bun prisma generate",
    "db:migrate": "bun --env-file=.env.development x --bun prisma migrate dev",
    "db:push": "bun --env-file=.env.development x --bun prisma db push",
    "db:seed": "bun --env-file=.env.development scripts/seed-draws.ts",
    "db:compute-stats": "bun --env-file=.env.development scripts/compute-stats.ts",
    "db:audit": "bun --env-file=.env.development scripts/db-audit.ts",
    "db:studio": "bun --env-file=.env.development x --bun prisma studio",
    "db:migrate:prod": "bun run scripts/run-with-env.ts .env.production -- bunx --bun prisma migrate deploy",
    "db:push:prod": "bun run scripts/run-with-env.ts .env.production -- bunx --bun prisma db push",
    "db:studio:prod": "bun run scripts/run-with-env.ts .env.production -- bunx --bun prisma studio",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{js,cjs,mjs}": [
      "biome check --write --no-errors-on-unmatched",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,yaml}": [
      "biome format --write"
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "elysia": "^1.4.28",
    "lucide-react": "^1.11.0",
    "motion": "^12.38.0",
    "next": "^16.2.4",
    "pg": "^8.16.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.3.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bun": "^1.3.13",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prisma": "^7.8.0",
    "shadcn": "^3.4.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^6.0.3"
  }
}
