generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "bun"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum LotteryType {
  THAI_GOVERNMENT
}

enum LotteryPrizeType {
  FIRST
  THREE_DIGIT
  THREE_FRONT
  THREE_BACK
  TWO_DIGIT
  NEAR_FIRST
  PRIZE2
  PRIZE3
  PRIZE4
  PRIZE5
  OTHER
}

enum WatchlistSource {
  MANUAL
  PREDICTION
  NOTEBOOK
}

enum SourceStatus {
  IMPORTED
  PARTIAL
  VERIFIED
}

model LotteryDraw {
  id              String           @id @default(uuid(7)) @map("_id") @db.Uuid
  lotteryType     LotteryType      @default(THAI_GOVERNMENT)
  drawDate        DateTime
  drawNo          String?
  sourceUrl       String?
  sourceStatus    SourceStatus     @default(IMPORTED)
  publishedAt     DateTime?
  metadata        Json?
  prizes          LotteryPrize[]
  backtestResults BacktestResult[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([lotteryType, drawDate])
  @@index([drawDate])
  @@index([sourceStatus])
  @@index([publishedAt])
  @@map("lottery_draws")
}

model LotteryPrize {
  id        String           @id @default(uuid(7)) @map("_id") @db.Uuid
  drawId    String           @db.Uuid
  draw      LotteryDraw      @relation(fields: [drawId], references: [id], onDelete: Cascade)
  type      LotteryPrizeType
  position  Int?
  number    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([drawId])
  @@index([type, number])
  @@map("lottery_prizes")
}

model UserWatchlistItem {
  id        String          @id @default(uuid(7)) @map("_id") @db.Uuid
  number    String
  source    WatchlistSource @default(MANUAL)
  tags      String[]
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([number])
  @@index([updatedAt])
  @@map("user_watchlist_items")
}

model PredictionRun {
  id           String             @id @default(uuid(7)) @map("_id") @db.Uuid
  strategy     String
  lotteryType  LotteryType?
  prizeType    LotteryPrizeType?
  numberLength Int?
  windowSize   Int?
  count        Int?
  generatedAt  DateTime?
  version      String?
  params       Json?
  items        PredictionResult[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([strategy])
  @@index([lotteryType, prizeType])
  @@index([generatedAt])
  @@map("prediction_runs")
}

model PredictionResult {
  id             String        @id @default(uuid(7)) @map("_id") @db.Uuid
  runId          String        @db.Uuid
  run            PredictionRun @relation(fields: [runId], references: [id])
  number         String
  score          Float
  reasons        String[]
  inputWindow    Int?
  numberLength   Int?
  rank           Int?
  scoreBreakdown Json?
  strategyId     String?
  strategyName   String?
  version        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([runId])
  @@index([runId, rank])
  @@index([number])
  @@map("prediction_results")
}

model DigitStatSnapshot {
  id               String      @id @default(uuid(7)) @map("_id") @db.Uuid
  lotteryType      LotteryType
  prizeType        LotteryPrizeType
  windowSize       Int
  digit            String
  position         Int?
  drawCount        Int
  hitCount         Int
  frequencyPercent Float
  lastSeenDrawDate DateTime?
  missingDrawCount Int
  trendDirection   String
  computedAt       DateTime
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([lotteryType, prizeType, windowSize, computedAt])
  @@index([lotteryType, prizeType, windowSize, digit, position])
  @@map("digit_stat_snapshots")
}

model NumberStatSnapshot {
  id               String      @id @default(uuid(7)) @map("_id") @db.Uuid
  lotteryType      LotteryType
  prizeType        LotteryPrizeType
  windowSize       Int
  number           String
  numberLength     Int
  drawCount        Int
  hitCount         Int
  frequencyPercent Float
  lastSeenDrawDate DateTime?
  missingDrawCount Int
  averageGap       Float?
  maxGap           Float?
  trendScore       Float
  patternFlags     Json?
  computedAt       DateTime
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([lotteryType, prizeType, windowSize, computedAt])
  @@index([lotteryType, prizeType, windowSize, number], map: "number_stat_snapshots_window_number_idx")
  @@index([lotteryType, prizeType, windowSize, numberLength], map: "number_stat_snapshots_window_number_length_idx")
  @@map("number_stat_snapshots")
}

model BacktestRun {
  id                String           @id @default(uuid(7)) @map("_id") @db.Uuid
  strategyId        String
  strategyName      String
  params            Json?
  lotteryType       LotteryType
  prizeType         LotteryPrizeType
  numberLength      Int
  startDrawDate     DateTime
  endDrawDate       DateTime
  candidateCount    Int
  hitRate           Float
  longestMissStreak Int
  averageHitRank    Float?
  coverage          Int
  computedAt        DateTime
  version           String
  results           BacktestResult[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([strategyId])
  @@index([lotteryType, prizeType])
  @@index([computedAt])
  @@map("backtest_runs")
}

model BacktestResult {
  id               String      @id @default(uuid(7)) @map("_id") @db.Uuid
  runId            String      @db.Uuid
  run              BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  drawId           String      @db.Uuid
  draw             LotteryDraw @relation(fields: [drawId], references: [id])
  drawDate         DateTime
  generatedNumbers String[]
  actualNumbers    String[]
  isHit            Boolean
  hitNumbers       String[]
  rankOfHit        Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([runId])
  @@index([runId, drawDate])
  @@index([drawId])
  @@map("backtest_results")
}
