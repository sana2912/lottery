generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "bun"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum LotteryType {
  THAI_GOVERNMENT
}

enum LotteryPrizeType {
  FIRST
  THREE_DIGIT
  THREE_FRONT
  THREE_BACK
  TWO_DIGIT
  NEAR_FIRST
  PRIZE2
  PRIZE3
  PRIZE4
  PRIZE5
  OTHER
}

enum SourceStatus {
  IMPORTED
  PARTIAL
  VERIFIED
}

model LotteryDraw {
  id              String           @id @default(uuid(7)) @map("_id") @db.Uuid
  lotteryType     LotteryType      @default(THAI_GOVERNMENT)
  drawDate        DateTime
  drawNo          String?
  sourceUrl       String?
  sourceStatus    SourceStatus     @default(IMPORTED)
  publishedAt     DateTime?
  metadata        Json?
  prizes          LotteryPrize[]
  backtestResults BacktestResult[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([lotteryType, drawDate])
  @@index([drawDate])
  @@index([sourceStatus])
  @@index([publishedAt])
  @@map("lottery_draws")
}

model LotteryPrize {
  id        String           @id @default(uuid(7)) @map("_id") @db.Uuid
  drawId    String           @db.Uuid
  draw      LotteryDraw      @relation(fields: [drawId], references: [id], onDelete: Cascade)
  type      LotteryPrizeType
  position  Int?
  number    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([drawId])
  @@index([type, number])
  @@map("lottery_prizes")
}

model PredictionRun {
  id           String             @id @default(uuid(7)) @map("_id") @db.Uuid
  strategy     String
  lotteryType  LotteryType?
  prizeType    LotteryPrizeType?
  numberLength Int?
  windowSize   Int?
  count        Int?
  generatedAt  DateTime?
  version      String?
  params       Json?
  items        PredictionResult[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([strategy])
  @@index([lotteryType, prizeType])
  @@index([generatedAt])
  @@map("prediction_runs")
}

model PredictionResult {
  id             String        @id @default(uuid(7)) @map("_id") @db.Uuid
  runId          String        @db.Uuid
  run            PredictionRun @relation(fields: [runId], references: [id])
  number         String
  score          Float
  reasons        String[]
  inputWindow    Int?
  numberLength   Int?
  rank           Int?
  scoreBreakdown Json?
  strategyId     String?
  strategyName   String?
  version        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([runId])
  @@index([runId, rank])
  @@index([number])
  @@map("prediction_results")
}

model AnalysisSnapshotRun {
  id                 String                    @id @default(uuid(7)) @map("_id") @db.Uuid
  contextKey         String                    @unique
  lotteryType        LotteryType
  prizeType          String
  numberLength       Int
  scope              String
  month              Int?
  windowPreset       String
  windowSize         Int?
  sampleDrawCount    Int
  samplePrizeCount   Int
  invalidPrizeCount  Int                       @default(0)
  startDrawDate      DateTime?
  endDrawDate        DateTime?
  analyticsReadModel Json
  patternReadModel   Json?
  calendarReadModel  Json?
  engineVersion      String
  computedAt         DateTime
  digitStats         AnalysisDigitStat[]
  numberStats        AnalysisNumberStat[]
  patternSummaries   AnalysisPatternSummary[]
  calendarHeatmaps   AnalysisCalendarHeatmap[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([lotteryType, prizeType, scope, month, windowPreset], map: "analysis_runs_context_idx")
  @@index([engineVersion, computedAt], map: "analysis_runs_engine_idx")
  @@map("analysis_snapshot_runs")
}

model AnalysisDigitStat {
  id               String              @id @default(uuid(7)) @map("_id") @db.Uuid
  runId            String              @db.Uuid
  run              AnalysisSnapshotRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  lotteryType      LotteryType
  prizeType        String
  windowPreset     String
  digit            String
  position         Int?
  drawCount        Int
  hitCount         Int
  frequencyPercent Float
  lastSeenDrawDate DateTime?
  missingDrawCount Int
  trendDirection   String
  computedAt       DateTime
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([runId])
  @@index([runId, hitCount(sort: Desc)], map: "analysis_digit_run_rank_idx")
  @@index([lotteryType, prizeType, windowPreset, position, digit], map: "analysis_digit_position_idx")
  @@map("analysis_digit_stats")
}

model AnalysisNumberStat {
  id               String              @id @default(uuid(7)) @map("_id") @db.Uuid
  runId            String              @db.Uuid
  run              AnalysisSnapshotRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  lotteryType      LotteryType
  prizeType        String
  windowPreset     String
  number           String
  numberLength     Int
  drawCount        Int
  hitCount         Int
  frequencyPercent Float
  lastSeenDrawDate DateTime?
  missingDrawCount Int
  averageGap       Float?
  maxGap           Float?
  trendScore       Float
  patternFlags     Json?
  computedAt       DateTime
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([runId])
  @@index([runId, trendScore(sort: Desc), hitCount(sort: Desc)], map: "analysis_number_run_rank_idx")
  @@index([runId, missingDrawCount(sort: Desc)], map: "analysis_number_run_missing_idx")
  @@index([lotteryType, prizeType, windowPreset, number], map: "analysis_number_value_idx")
  @@index([lotteryType, prizeType, windowPreset, numberLength], map: "analysis_number_length_idx")
  @@map("analysis_number_stats")
}

model AnalysisPatternSummary {
  id               String              @id @default(uuid(7)) @map("_id") @db.Uuid
  runId            String              @db.Uuid
  run              AnalysisSnapshotRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  lotteryType      LotteryType
  prizeType        String
  windowPreset     String
  pattern          String
  hitCount         Int
  frequencyPercent Float
  sampleSize       Int
  examples         String[]
  computedAt       DateTime
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([runId])
  @@index([lotteryType, prizeType, windowPreset, pattern], map: "analysis_pattern_value_idx")
  @@map("analysis_pattern_summaries")
}

model AnalysisCalendarHeatmap {
  id              String              @id @default(uuid(7)) @map("_id") @db.Uuid
  runId           String              @db.Uuid
  run             AnalysisSnapshotRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  lotteryType     LotteryType
  prizeType       String
  scope           String
  month           Int?
  windowPreset    String
  position        Int
  digit           String
  appearanceCount Int
  missingRounds   Int
  score           Float
  tone            String
  computedAt      DateTime
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([runId])
  @@index([lotteryType, prizeType, scope, month, windowPreset, position, digit], map: "analysis_heatmap_cell_idx")
  @@map("analysis_calendar_heatmaps")
}

model BacktestRun {
  id                String           @id @default(uuid(7)) @map("_id") @db.Uuid
  strategyId        String
  strategyName      String
  params            Json?
  lotteryType       LotteryType
  prizeType         LotteryPrizeType
  numberLength      Int
  startDrawDate     DateTime
  endDrawDate       DateTime
  candidateCount    Int
  hitRate           Float
  longestMissStreak Int
  averageHitRank    Float?
  coverage          Int
  computedAt        DateTime
  version           String
  results           BacktestResult[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([strategyId])
  @@index([lotteryType, prizeType])
  @@index([computedAt])
  @@map("backtest_runs")
}

model BacktestResult {
  id               String      @id @default(uuid(7)) @map("_id") @db.Uuid
  runId            String      @db.Uuid
  run              BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  drawId           String      @db.Uuid
  draw             LotteryDraw @relation(fields: [drawId], references: [id])
  drawDate         DateTime
  generatedNumbers String[]
  actualNumbers    String[]
  isHit            Boolean
  hitNumbers       String[]
  rankOfHit        Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([runId])
  @@index([runId, drawDate])
  @@index([drawId])
  @@map("backtest_results")
}
